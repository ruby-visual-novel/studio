        function renderWriterDashboardData() {
            const currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
            let unlocks = JSON.parse(localStorage.getItem('mynovel_unlocks')) || [];
            let novels = getNovels();
            let searchQuery = (document.getElementById('searchWriterDashboardInput')?.value || '').toLowerCase().trim();
            
            // กรองเฉพาะตอนที่เป็นของนักเขียนคนนี้ (หรือถ้าเป็นแอดมินสามารถค้นหาผ่านแว่นขยายรายคนได้)
            let myNovels = novels.filter(n => {
                if (currentUser.role === 'super_admin' || currentUser.role === 'admin') {
                    if (searchQuery) {
                        return n.author.toLowerCase().includes(searchQuery) || n.authorEmail.toLowerCase().includes(searchQuery);
                    }
                    return true;
                }
                return n.authorEmail === currentUser.email;
            });

            let myNovelIds = myNovels.map(n => n.id);
            let myUnlocks = unlocks.filter(u => myNovelIds.includes(u.novelId));
            
            let totalCoins = myUnlocks.reduce((sum, u) => sum + (u.price || 0), 0);
            let earnings80 = totalCoins * 0.80;
            let company20 = totalCoins * 0.20;

            document.getElementById('writerTotalCoins').innerText = `${totalCoins} 🪙`;
            document.getElementById('writerEarnings80').innerText = `${earnings80.toFixed(2)} บาท`;
            document.getElementById('companyShare20').innerText = `${company20.toFixed(2)} บาท`;

            let listContainer = document.getElementById('writerUnlockHistoryList');
            listContainer.innerHTML = myUnlocks.length === 0 ? `<p class="text-xs text-zinc-500 text-center py-4">ยังไม่มีประวัติการปลดล็อกตอนนิยาย (ข้อมูลเก็บบันทึกย้อนหลัง 6 เดือน)</p>` : myUnlocks.map(u => `
                <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800 flex justify-between items-center text-xs">
                    <div>
                        <p class="font-bold text-zinc-200">${escapeHtml(u.novelTitle)} - ${escapeHtml(u.episodeTitle)}</p>
                        <p class="text-zinc-500 mt-0.5">นักเขียน: ${escapeHtml(u.authorEmail || 'ไม่ระบุ')} | ผู้อ่าน: ${escapeHtml(u.readerEmail)} | เวลา: ${u.time}</p>
