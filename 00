            if (favorites.includes(novelId)) { favorites = favorites.filter(id => id !== novelId); alert('นำออกจากรายการโปรดแล้ว'); }
            else { favorites.push(novelId); alert('เพิ่มลงรายการโปรดแล้ว ❤️'); }
