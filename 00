                <div onclick="clickNotification('${n.id}', '${n.novelId}', '${n.episodeId}')" class="p-3 hover:bg-zinc-800 cursor-pointer transition ${n.isRead ? 'opacity-60 bg-zinc-900' : 'bg-zinc-950 border-l-4 border-red-600'}">
