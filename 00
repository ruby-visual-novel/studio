        function backToDetail() { if (activeNovelId) openNovelDetail(activeNovelId); else goHome(); }

        function renderCurrentScene() {
            recordReadingProgress();
            const scene = currentScenes[currentSceneIndex];
            if (!scene) { alert("จบตอนแล้ว!"); backToDetail(); return; }
            document.getElementById('sceneBg').style.backgroundImage = `linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.8)), url('${scene.bg || 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=800&q=80'}')`;
            document.getElementById('charName').innerText = scene.charName || 'ผู้บรรยาย';
            document.getElementById('dialogueText').innerText = scene.text;
            
            if (scene.hasChoice) {
                document.getElementById('choiceBox').classList.remove('hidden');
                document.getElementById('nextBtnContainer').classList.add('hidden');
                
                for (let i = 1; i <= 4; i++) {
                    const btn = document.getElementById(`choiceBtn${i}`);
                    const text = scene[`choice${i}Text`];
                    if (text && text.trim() !== '') {
                        btn.innerText = `${i}. ${text}`;
                        btn.classList.remove('hidden');
                    } else {
                        btn.classList.add('hidden');
                    }
                }
            } else {
                document.getElementById('choiceBox').classList.add('hidden');
                document.getElementById('nextBtnContainer').classList.remove('hidden');
            }
        }

        function nextScene() { currentSceneIndex++; if (currentSceneIndex < currentScenes.length) renderCurrentScene(); else { alert("จบตอนแล้ว!"); backToDetail(); } }
        function makeChoice(num) {
            const scene = currentScenes[currentSceneIndex];
            const target = parseInt(scene[`choice${num}Next`]);
            if (!isNaN(target) && target >= 0 && target < currentScenes.length) { currentSceneIndex = target; renderCurrentScene(); } else { nextScene(); }
        }

        function openAdminStudio() {
            const currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
            if (!currentUser || (currentUser.role !== 'super_admin' && currentUser.role !== 'admin' && currentUser.role !== 'author')) { alert("ไม่มีสิทธิ์เข้าถึงสตูดิโอ"); return; }
            hideAllViews();
            document.getElementById('adminStudioView').classList.remove('hidden');
            document.getElementById('searchAdminNovelInput').value = "";
            renderAdminNovels();
        }

