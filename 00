        function approveTopupWithCustomCoins(topupId, isApproved) {
            let topups = JSON.parse(localStorage.getItem('mynovel_topups')) || [];
            let t = topups.find(item => item.id === topupId);
            if (!t) return;

            if (!isApproved) {
                t.status = 'rejected';
                localStorage.setItem('mynovel_topups', JSON.stringify(topups));
                renderPendingTopups();
                renderSuperAdminTopupHistory();
                alert("ปฏิเสธรายการเรียบร้อยแล้ว");
                return;
            }

            let inputVal = document.getElementById(`inputCoins_${topupId}`).value;
            let coinsToAdd = parseInt(inputVal);
            if (isNaN(coinsToAdd) || coinsToAdd <= 0) {
                alert("กรุณากรอกจำนวนเหรียญให้ถูกต้อง มากกว่า 0");
                return;
            }

            t.coins = coinsToAdd;
            t.status = 'approved';
            localStorage.setItem('mynovel_topups', JSON.stringify(topups));

            let users = JSON.parse(localStorage.getItem('mynovel_users')) || [];
            let u = users.find(user => user.email === t.email);
            if (u) {
                u.coins = (u.coins || 0) + coinsToAdd;
                localStorage.setItem('mynovel_users', JSON.stringify(users));
                let currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
                if (currentUser && currentUser.email === t.email) {
                    currentUser.coins = u.coins;
                    localStorage.setItem('mynovel_currentUser', JSON.stringify(currentUser));
                    updateUIByAuth();
                }
            }
            renderPendingTopups();
            renderSuperAdminTopupHistory();
            alert(`เติม ${coinsToAdd} เหรียญ สำเร็จ!`);
        }

        function revertTopup(topupId) {
            let topups = JSON.parse(localStorage.getItem('mynovel_topups')) || [];
            let t = topups.find(item => item.id === topupId);
            if (!t || t.status !== 'approved') return;

            let coinsToDeduct = t.coins || 0;
            if (!confirm(`คุณต้องการดึงเงิน/เหรียญกลับจำนวน ${coinsToDeduct} เหรียญ จากบัญชี (${t.email}) ใช่หรือไม่?`)) return;

            let users = JSON.parse(localStorage.getItem('mynovel_users')) || [];
            let u = users.find(user => user.email === t.email);
            if (u) {
                u.coins = Math.max(0, (u.coins || 0) - coinsToDeduct);
                localStorage.setItem('mynovel_users', JSON.stringify(users));
                let currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
                if (currentUser && currentUser.email === t.email) {
                    currentUser.coins = u.coins;
                    localStorage.setItem('mynovel_currentUser', JSON.stringify(currentUser));
                    updateUIByAuth();
                }
            }

            t.status = 'pending';
            t.coins = 0;
            localStorage.setItem('mynovel_topups', JSON.stringify(topups));
            renderPendingTopups();
            renderSuperAdminTopupHistory();
            alert("ดึงเงินกลับเรียบร้อยแล้ว");
