            const searchQuery = (document.getElementById('searchAdminNovelInput')?.value || '').toLowerCase().trim();

            let allNovels = getNovels();
            let myNovels = allNovels.filter(n => currentUser.role === 'super_admin' || currentUser.role === 'admin' || n.authorEmail === currentUser.email);

