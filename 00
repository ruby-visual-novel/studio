                myNovels = myNovels.filter(n => n.title.toLowerCase().includes(searchQuery));
            }

            list.innerHTML = myNovels.length === 0 ? `<div class="theme-card bg-zinc-900 p-8 rounded-xl text-center text-zinc-500 border border-zinc-800">ยังไม่มีนิยายของคุณ</div>` : myNovels.map(novel => `
                <div class="theme-card bg-zinc-900 rounded-xl shadow-sm border border-zinc-800 p-4">
                    <div class="flex flex-col sm:flex-row justify-between gap-3 pb-3 border-b border-zinc-800">
                        <div><span class="text-[11px] bg-red-950 text-red-400 px-2 py-0.5 rounded font-medium border border-red-900">${novel.category}</span><h3 class="font-bold text-lg inline ml-2">${escapeHtml(novel.title)}</h3></div>
                        <div class="flex flex-wrap gap-2 items-center">
                            <button type="button" onclick="togglePublishNovel('${novel.id}')" class="text-xs px-3 py-1.5 rounded-lg font-semibold cursor-pointer ${novel.published !== false ? 'bg-emerald-950 text-emerald-400 border border-emerald-900' : 'bg-zinc-800 text-zinc-400'}">
                                ${novel.published !== false ? '🟢 เผยแพร่เรื่อง' : '🔴 ซ่อนเรื่อง'}
                            </button>
                            <button type="button" onclick="openEpisodeEditor('${novel.id}', null)" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-1.5 rounded-lg font-medium cursor-pointer">+ ตอน</button>
                            <button type="button" onclick="openEditNovelModal('${novel.id}')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs px-3 py-1.5 rounded-lg font-medium cursor-pointer">แก้ไข</button>
                            <button type="button" onclick="deleteNovel('${novel.id}')" class="bg-red-950 hover:bg-red-900 text-red-400 text-xs px-3 py-1.5 rounded-lg font-medium cursor-pointer border border-red-900">ลบ</button>
                        </div>
                    </div>
                    <div class="mt-3 space-y-2">${(novel.episodes || []).map(ep => `
                        <div class="flex flex-col sm:flex-row justify-between bg-zinc-950 p-3 rounded-xl border border-zinc-800 text-sm items-start sm:items-center gap-2">
                            <div>
                                <span class="font-medium">${escapeHtml(ep.title)}</span>
                                <span class="ml-2 text-xs text-zinc-500">(${(ep.scenes || []).length} ฉาก | ${ep.price > 0 ? ep.price + ' เหรียญ' : 'ฟรี'})</span>
                            </div>
                            <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
                                <button type="button" onclick="togglePublishEpisode('${novel.id}', '${ep.id}')" class="text-xs px-3 py-1 rounded-lg font-semibold cursor-pointer ${ep.published !== false ? 'bg-emerald-950 text-emerald-400 border border-emerald-900' : 'bg-zinc-800 text-zinc-400'}">
                                    ${ep.published !== false ? '🟢 เผยแพร่แล้ว' : '🔴 ซ่อนอยู่'}
                                </button>
                                <div class="flex gap-1.5">
                                    <button type="button" onclick="openEpisodeEditor('${novel.id}', '${ep.id}')" class="bg-red-800 hover:bg-red-900 text-white text-xs px-2.5 py-1 rounded cursor-pointer">แก้ไข</button>
                                    <button type="button" onclick="deleteEpisode('${novel.id}', '${ep.id}')" class="bg-red-600 hover:bg-red-700 text-white text-xs px-2.5 py-1 rounded cursor-pointer">ลบ</button>
                                </div>
                            </div>
                        </div>
                    `).join('')}</div>
                </div>
            `).join('');
        }

        function togglePublishNovel(novelId) {
            let novels = getNovels();
            let n = novels.find(item => item.id === novelId);
            if (!n) return;
            n.published = n.published === false ? true : false;
            if (saveNovelsData(novels)) {
                renderAdminNovels();
                renderHomeNovels();
            }
        }

        function togglePublishEpisode(novelId, epId) {
            let novels = getNovels();
            let n = novels.find(item => item.id === novelId);
            if (!n) return;
            let ep = n.episodes.find(item => item.id === epId);
            if (!ep) return;
            ep.published = ep.published === false ? true : false;
            if (saveNovelsData(novels)) {
                renderAdminNovels();
            }
        }

        function openNewNovelModal() {
            document.getElementById('novelModalTitle').innerText = "เพิ่มเรื่องนิยายใหม่";
            document.getElementById('editNovelId').value = "";
            document.getElementById('novelTitleInput').value = "";
            document.getElementById('novelCategoryInput').value = "Romance";
            document.getElementById('novelCoverInput').value = "";
            document.getElementById('coverPreviewContainer').classList.add('hidden');
            document.getElementById('novelDescInput').value = "";
            document.getElementById('novelPublishedToggle').checked = true;
            document.getElementById('novelFormModal').classList.remove('hidden');
        }

        function openEditNovelModal(id) {
            const novel = getNovels().find(n => n.id === id);
            if (!novel) return;
            document.getElementById('novelModalTitle').innerText = "แก้ไขข้อมูลเรื่อง";
            document.getElementById('editNovelId').value = novel.id;
            document.getElementById('novelTitleInput').value = novel.title;
            document.getElementById('novelCategoryInput').value = novel.category || "Romance";
            document.getElementById('novelCoverInput').value = novel.cover;
            previewCoverInput(novel.cover);
            document.getElementById('novelDescInput').value = novel.description;
            document.getElementById('novelPublishedToggle').checked = novel.published !== false;
            document.getElementById('novelFormModal').classList.remove('hidden');
        }

        function handleCoverFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            compressImageFile(file, 600, 0.75, function(compressedBase64) {
                document.getElementById('novelCoverInput').value = compressedBase64;
                previewCoverInput(compressedBase64);
            });
        }

        function previewCoverInput(url) {
            const previewContainer = document.getElementById('coverPreviewContainer');
            const previewImg = document.getElementById('coverPreviewImg');
            if (url && url.trim() !== '') {
                previewImg.src = url;
                previewContainer.classList.remove('hidden');
            } else {
                previewContainer.classList.add('hidden');
            }
        }

        function saveNovel(e) {
            e.preventDefault();
            const currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
            let novels = getNovels();
            const editId = document.getElementById('editNovelId').value;
            const title = document.getElementById('novelTitleInput').value;
            const category = document.getElementById('novelCategoryInput').value;
            const cover = document.getElementById('novelCoverInput').value || 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80';
            const description = document.getElementById('novelDescInput').value;
            const published = document.getElementById('novelPublishedToggle').checked;

            if (editId) {
                let n = novels.find(item => item.id === editId);
                if (n) { n.title = title; n.category = category; n.cover = cover; n.description = description; n.published = published; }
            } else {
                novels.push({ id: "novel_" + Date.now(), title, category, author: currentUser.name, authorEmail: currentUser.email, cover, description, published, episodes: [] });
            }
            if (saveNovelsData(novels)) {
                closeModal('novelFormModal');
                openAdminStudio();
                renderHomeNovels();
            }
        }

        function deleteNovel(id) {
            if (!confirm("ลบนิยายเรื่องนี้ใช่หรือไม่?")) return;
            if (saveNovelsData(getNovels().filter(n => n.id !== id))) {
                renderAdminNovels();
                renderHomeNovels();
                goHome();
            }
        }

        let tempScenes = [];
        let draftSaveTimer = null;
        let currentEditingKey = null;

        function getDraftStorageKey(novelId, epId) {
            return `ruby_draft_${novelId}_${epId || 'new'}`;
        }

        function triggerAutosave() {
            if (!currentEditingKey) return;
            clearTimeout(draftSaveTimer);
            draftSaveTimer = setTimeout(() => {
                saveCurrentDraftToLocalStorage(false);
            }, 1000);
        }

        function saveCurrentDraftToLocalStorage(showAlert = false) {
            if (!currentEditingKey) return;
            try {
                const title = document.getElementById('epTitleInput').value;
                const price = document.getElementById('epPriceInput').value;
                const draftData = {
                    title,
                    price,
                    scenes: tempScenes,
                    savedAt: new Date().toLocaleString('th-TH'),
                    timestamp: Date.now()
                };
                localStorage.setItem(currentEditingKey, JSON.stringify(draftData));
                const badge = document.getElementById('draftStatusBadge');
                badge.classList.remove('hidden');
                badge.innerText = `💾 บันทึกร่างอัตโนมัติล่าสุด (${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'})})`;
                if (showAlert) {
                    alert("บันทึกแบบร่างเรียบร้อยแล้ว!");
                }
            } catch (e) {
                if (showAlert) {
                    alert("⚠️ พื้นที่จัดเก็บแบบร่างเต็ม แนะนำให้กด 'บันทึกตอน' ทันทีครับ");
                }
            }
        }

        function manualSaveDraft() {
            saveCurrentDraftToLocalStorage(true);
        }

        function checkExistingDraft(novelId, epId) {
            currentEditingKey = getDraftStorageKey(novelId, epId);
            const savedDraftJson = localStorage.getItem(currentEditingKey);
            const banner = document.getElementById('draftAlertBanner');
            
            if (savedDraftJson) {
                try {
                    const draft = JSON.parse(savedDraftJson);
                    document.getElementById('draftTimeSpan').innerText = draft.savedAt;
                    banner.classList.remove('hidden');
                    window.pendingDraftData = draft;
                } catch(e) {
                    banner.classList.add('hidden');
                }
            } else {
                banner.classList.add('hidden');
            }
        }

        function restoreDraft() {
            if (window.pendingDraftData) {
                document.getElementById('epTitleInput').value = window.pendingDraftData.title || '';
                document.getElementById('epPriceInput').value = window.pendingDraftData.price || 0;
                tempScenes = (window.pendingDraftData.scenes && window.pendingDraftData.scenes.length > 0) 
                    ? window.pendingDraftData.scenes 
                    : [{ bg: "", charName: "ตัวละครเอก", text: "", hasChoice: false }];
                renderSceneBlocks();
                document.getElementById('draftAlertBanner').classList.add('hidden');
                alert("กู้คืนข้อมูลร่างสำเร็จ!");
            }
        }

        function discardDraft() {
            if (confirm("คุณต้องการลบบันทึกร่างนี้ทิ้งใช่หรือไม่?")) {
                localStorage.removeItem(currentEditingKey);
                document.getElementById('draftAlertBanner').classList.add('hidden');
                window.pendingDraftData = null;
                alert("ลบบันทึกร่างแล้ว");
            }
        }

        function previewDraftEpisode() {
            if (tempScenes.length === 0 || !tempScenes[0].text) {
                alert("กรุณาเพิ่มเนื้อหาอย่างน้อย 1 ฉากก่อนพรีวิว");
                return;
            }
            currentScenes = tempScenes;
            currentSceneIndex = 0;
            const titleInput = document.getElementById('epTitleInput').value || "พรีวิวตอน";
            document.getElementById('readerEpisodeTitle').innerText = `[โหมดพรีวิว] ${titleInput}`;
            closeModal('episodeEditorModal');
            hideAllViews();
            document.getElementById('readerView').classList.remove('hidden');
            renderCurrentScene();
        }

        function openEpisodeEditor(novelId, epId) {
            const novel = getNovels().find(n => n.id === novelId);
            if (!novel) {
                alert("ไม่พบข้อมูลนิยาย กรุณารีเฟรชหน้าเว็บอีกครั้ง");
                return;
            }

            document.getElementById('epNovelId').value = novelId;
            document.getElementById('editEpId').value = epId || "";
            document.getElementById('draftStatusBadge').classList.add('hidden');

            if (epId) {
                const ep = (novel.episodes || []).find(e => e.id === epId);
                if (!ep) {
                    alert("ไม่พบข้อมูลตอนนี้");
                    return;
                }
                document.getElementById('epModalTitle').innerText = `แก้ไขตอน: ${ep.title}`;
                document.getElementById('epTitleInput').value = ep.title;
                document.getElementById('epPriceInput').value = ep.price || 0;
                tempScenes = (ep.scenes && ep.scenes.length > 0) 
                    ? JSON.parse(JSON.stringify(ep.scenes)) 
                    : [{ bg: "", charName: "ตัวละครเอก", text: "", hasChoice: false }];
            } else {
                const epCount = (novel.episodes || []).length;
                document.getElementById('epModalTitle').innerText = `เพิ่มตอนใหม่`;
                document.getElementById('epTitleInput').value = `ตอนที่ ${epCount + 1}: `;
                document.getElementById('epPriceInput').value = 0;
                tempScenes = [{ bg: "", charName: "ตัวละครเอก", text: "", hasChoice: false }];
            }

            checkExistingDraft(novelId, epId);

            renderSceneBlocks();
            document.getElementById('episodeEditorModal').classList.remove('hidden');
        }

        function renderSceneBlocks() {
            const container = document.getElementById('scenesContainer');
            if (!tempScenes || tempScenes.length === 0) {
                tempScenes = [{ bg: "", charName: "ตัวละครเอก", text: "", hasChoice: false }];
            }
            container.innerHTML = tempScenes.map((scene, i) => `
                <div class="border border-zinc-800 rounded-xl p-3.5 bg-zinc-950 space-y-2">
                    <div class="flex justify-between items-center"><span class="bg-red-800 text-white text-xs font-bold px-2 py-0.5 rounded">ฉากที่ ${i + 1}</span>${tempScenes.length > 1 ? `<button type="button" onclick="removeSceneBlock(${i})" class="text-xs text-red-400 font-medium cursor-pointer">ลบ</button>` : ''}</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <input type="text" value="${escapeHtml(scene.charName || '')}" oninput="updateTempScene(${i}, 'charName', this.value)" placeholder="ชื่อตัวละคร" class="px-2.5 py-1.5 border border-zinc-700 bg-zinc-900 text-white rounded text-xs">
                        
                        <div class="space-y-1">
                            <div class="flex gap-1 items-center">
                                <input type="text" value="${escapeHtml(scene.bg || '')}" oninput="updateTempScene(${i}, 'bg', this.value); previewSceneBgInput(${i}, this.value)" id="sceneBgInput_${i}" placeholder="วางลิงก์ URL หรือเลือกไฟล์..." class="flex-1 px-2.5 py-1.5 border border-zinc-700 bg-zinc-900 text-white rounded text-xs">
                                <input type="file" id="sceneBgFile_${i}" accept="image/*" onchange="handleSceneFileUpload(event, ${i})" class="hidden">
                                <button type="button" onclick="document.getElementById('sceneBgFile_${i}').click()" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs px-2.5 py-1.5 rounded font-medium whitespace-nowrap cursor-pointer">📁 เลือกไฟล์</button>
                            </div>
                            <div id="sceneBgPreview_${i}" class="${scene.bg ? '' : 'hidden'} mt-1">
                                <img src="${scene.bg || ''}" class="w-16 h-10 object-cover rounded border border-zinc-700" id="sceneBgImg_${i}">
                            </div>
                        </div>
                    </div>
                    <textarea rows="2" oninput="updateTempScene(${i}, 'text', this.value)" placeholder="บทสนทนา" class="w-full px-2.5 py-1.5 border border-zinc-700 bg-zinc-900 text-white rounded text-xs">${escapeHtml(scene.text || '')}</textarea>
                    <div>
                        <label class="inline-flex items-center cursor-pointer"><input type="checkbox" ${scene.hasChoice ? 'checked' : ''} onchange="toggleSceneChoice(${i}, this.checked)" class="rounded text-red-600"><span class="ml-2 text-xs font-semibold text-red-400">มีช้อยส์ให้เลือก (สูงสุด 4 ตัวเลือก)</span></label>
                        <div class="${scene.hasChoice ? '' : 'hidden'} mt-2 space-y-2 bg-zinc-900 p-2.5 border border-zinc-800 rounded-lg">
                            <div class="flex gap-2"><input type="text" value="${escapeHtml(scene.choice1Text || '')}" oninput="updateTempScene(${i}, 'choice1Text', this.value)" placeholder="ช้อยส์ 1" class="flex-1 px-2 py-1 border border-zinc-700 bg-zinc-950 text-white rounded text-xs"><select onchange="updateTempScene(${i}, 'choice1Next', this.value)" class="border border-zinc-700 bg-zinc-950 text-white rounded text-xs">${tempScenes.map((_, idx) => `<option value="${idx}" ${scene.choice1Next == idx ? 'selected' : ''}>ไปฉาก ${idx + 1}</option>`).join('')}</select></div>
                            <div class="flex gap-2"><input type="text" value="${escapeHtml(scene.choice2Text || '')}" oninput="updateTempScene(${i}, 'choice2Text', this.value)" placeholder="ช้อยส์ 2" class="flex-1 px-2 py-1 border border-zinc-700 bg-zinc-950 text-white rounded text-xs"><select onchange="updateTempScene(${i}, 'choice2Next', this.value)" class="border border-zinc-700 bg-zinc-950 text-white rounded text-xs">${tempScenes.map((_, idx) => `<option value="${idx}" ${scene.choice2Next == idx ? 'selected' : ''}>ไปฉาก ${idx + 1}</option>`).join('')}</select></div>
                            <div class="flex gap-2"><input type="text" value="${escapeHtml(scene.choice3Text || '')}" oninput="updateTempScene(${i}, 'choice3Text', this.value)" placeholder="ช้อยส์ 3 (ไม่บังคับ)" class="flex-1 px-2 py-1 border border-zinc-700 bg-zinc-950 text-white rounded text-xs"><select onchange="updateTempScene(${i}, 'choice3Next', this.value)" class="border border-zinc-700 bg-zinc-950 text-white rounded text-xs">${tempScenes.map((_, idx) => `<option value="${idx}" ${scene.choice3Next == idx ? 'selected' : ''}>ไปฉาก ${idx + 1}</option>`).join('')}</select></div>
                            <div class="flex gap-2"><input type="text" value="${escapeHtml(scene.choice4Text || '')}" oninput="updateTempScene(${i}, 'choice4Text', this.value)" placeholder="ช้อยส์ 4 (ไม่บังคับ)" class="flex-1 px-2 py-1 border border-zinc-700 bg-zinc-950 text-white rounded text-xs"><select onchange="updateTempScene(${i}, 'choice4Next', this.value)" class="border border-zinc-700 bg-zinc-950 text-white rounded text-xs">${tempScenes.map((_, idx) => `<option value="${idx}" ${scene.choice4Next == idx ? 'selected' : ''}>ไปฉาก ${idx + 1}</option>`).join('')}</select></div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function handleSceneFileUpload(event, index) {
            const file = event.target.files[0];
            if (!file) return;
            compressImageFile(file, 800, 0.75, function(compressedBase64) {
                tempScenes[index].bg = compressedBase64;
                document.getElementById(`sceneBgInput_${index}`).value = compressedBase64;
                previewSceneBgInput(index, compressedBase64);
                triggerAutosave();
            });
        }

        function previewSceneBgInput(index, url) {
            const previewDiv = document.getElementById(`sceneBgPreview_${index}`);
            const previewImg = document.getElementById(`sceneBgImg_${index}`);
            if (url && url.trim() !== '') {
                previewImg.src = url;
                previewDiv.classList.remove('hidden');
            } else {
                previewDiv.classList.add('hidden');
            }
        }

        function addSceneBlock() { 
            tempScenes.push({ bg: "", charName: "", text: "", hasChoice: false }); 
            renderSceneBlocks(); 
            triggerAutosave();
        }
        function removeSceneBlock(i) { 
            tempScenes.splice(i, 1); 
            renderSceneBlocks(); 
            triggerAutosave();
        }
        function updateTempScene(i, field, val) { 
            tempScenes[i][field] = val; 
            triggerAutosave(); 
        }
        function toggleSceneChoice(i, checked) { 
            tempScenes[i].hasChoice = checked; 
            renderSceneBlocks(); 
            triggerAutosave();
        }

        function saveEpisode(e) {
            e.preventDefault();
            const novelId = document.getElementById('epNovelId').value;
            const editEpId = document.getElementById('editEpId').value;
            const title = document.getElementById('epTitleInput').value;
            const price = parseInt(document.getElementById('epPriceInput').value) || 0;
            let novels = getNovels();
            let n = novels.find(item => item.id === novelId);
            if (!n) {
                alert("ไม่พบข้อมูลเรื่องนิยาย");
                return;
            }
            if (!n.episodes) n.episodes = [];

            let targetEpId = editEpId;
            if (editEpId) {
                let ep = n.episodes.find(item => item.id === editEpId);
                if (ep) { ep.title = title; ep.price = price; ep.scenes = tempScenes; }
            } else {
                targetEpId = "ep_" + Date.now();
                n.episodes.push({ id: targetEpId, title, price, published: true, scenes: tempScenes });
                
                triggerNovelUpdateNotification(n.id, n.title, title, targetEpId);
            }

            if (saveNovelsData(novels)) {
                if (currentEditingKey) {
                    localStorage.removeItem(currentEditingKey);
                }
                closeModal('episodeEditorModal');
                openAdminStudio();
                alert("บันทึกตอนเรียบร้อย!");
            }
        }

        function deleteEpisode(novelId, epId) {
            if (!confirm("ลบตอนนี้ใช่หรือไม่?")) return;
            let novels = getNovels();
            let n = novels.find(item => item.id === novelId);
            if (n) { 
                n.episodes = n.episodes.filter(ep => ep.id !== epId); 
                if (saveNovelsData(novels)) {
                    renderAdminNovels(); 
                    renderHomeNovels(); 
                }
            }
        }

        function hideAllViews() {
            ['homeView', 'novelDetailView', 'readerView', 'adminStudioView', 'writerDashboardView', 'superAdminView', 'supportInboxView', 'favoritesView', 'readingHistoryView'].forEach(id => document.getElementById(id).classList.add('hidden'));
        }

        function goHome() { hideAllViews(); document.getElementById('homeView').classList.remove('hidden'); renderHomeNovels(); }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
            document.getElementById('sidebarBackdrop').classList.toggle('hidden');
        }

        function toggleSearch() { document.getElementById('searchBar').classList.toggle('hidden'); }
        function escapeHtml(str) { return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

        updateUIByAuth();
        updateNotifBadge();
        renderHomeNovels();
    </script>
</body>
</html>
