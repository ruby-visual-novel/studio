        function getReadingHistory() { const key = getUserStorageKey('history'); return key ? JSON.parse(localStorage.getItem(key) || '[]') : []; }
        function saveReadingHistory(data) { const key = getUserStorageKey('history'); if (key) localStorage.setItem(key, JSON.stringify(data)); }

        function recordReadingProgress() {
            const email = getCurrentEmail();
            if (!email || !activeNovelId || !activeEpisodeId) return;
            let history = getReadingHistory();
            let novel = getNovels().find(n => n.id === activeNovelId);
            let ep = novel?.episodes.find(e => e.id === activeEpisodeId);
            if (!novel || !ep) return;
            let updated = history.filter(item => !(item.novelId === activeNovelId && item.episodeId === activeEpisodeId));
            updated.unshift({ novelId: activeNovelId, episodeId: activeEpisodeId, episodeTitle: ep.title, sceneIndex: currentSceneIndex, updatedAt: Date.now() });
            saveReadingHistory(updated.slice(0, 50));
        }

        function openReadingHistory() {
            if (!getCurrentEmail()) { alert('กรุณาเข้าสู่ระบบ'); openAuthModal('login'); return; }
            hideAllViews();
            document.getElementById('readingHistoryView').classList.remove('hidden');
            const list = document.getElementById('readingHistoryList');
            const history = getReadingHistory();
            const novels = getNovels();
            let valid = history.filter(item => novels.some(n => n.id === item.novelId));
            list.innerHTML = valid.length === 0 ? `<p class="text-center text-zinc-500 py-10">ยังไม่มีประวัติการอ่าน</p>` : valid.map(item => {
