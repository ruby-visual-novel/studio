        function startReadingEpisode(novelId, epId, resumeIndex = 0, skipPayment = false) {
            const novel = getNovels().find(n => n.id === novelId);
            const episode = novel.episodes.find(e => e.id === epId);
            if (!episode || episode.scenes.length === 0) { alert("ยังไม่มีเนื้อหาฉาก"); return; }

            const currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
            let hasUnlocked = false;
            if (currentUser) {
                if (!currentUser.unlockedEpisodes) currentUser.unlockedEpisodes = [];
                if (currentUser.role === 'super_admin' || currentUser.role === 'admin' || currentUser.email === novel.authorEmail || currentUser.unlockedEpisodes.includes(epId)) {
                    hasUnlocked = true;
                }
            }

            if (episode.price > 0 && !hasUnlocked && !skipPayment) {
                if (!currentUser) { alert("กรุณาเข้าสู่ระบบก่อนอ่าน"); openAuthModal('login'); return; }
                if (currentUser.coins < episode.price) { alert(`เหรียญไม่พอ (ต้องการ ${episode.price} เหรียญ)`); return; }
                if (!confirm(`ใช้ ${episode.price} เหรียญ เพื่อปลดล็อก "${episode.title}"?`)) return;

                currentUser.coins -= episode.price;
                if (!currentUser.unlockedEpisodes) currentUser.unlockedEpisodes = [];
                currentUser.unlockedEpisodes.push(epId);
                localStorage.setItem('mynovel_currentUser', JSON.stringify(currentUser));

                let users = JSON.parse(localStorage.getItem('mynovel_users')) || [];
                let u = users.find(user => user.email === currentUser.email);
                if (u) { u.coins = currentUser.coins; u.unlockedEpisodes = currentUser.unlockedEpisodes; localStorage.setItem('mynovel_users', JSON.stringify(users)); }
                
                // บันทึกประวัติการปลดล็อกตอนพร้อมบันทึก timestamp และ authorEmail
                let unlocks = JSON.parse(localStorage.getItem('mynovel_unlocks')) || [];
                unlocks.unshift({
                    novelId: novel.id,
                    novelTitle: novel.title,
                    episodeId: episode.id,
                    episodeTitle: episode.title,
                    price: episode.price,
                    authorEmail: novel.authorEmail,
                    readerEmail: currentUser.email,
                    time: new Date().toLocaleString('th-TH'),
                    timestamp: Date.now()
                });
                localStorage.setItem('mynovel_unlocks', JSON.stringify(unlocks));

                updateUIByAuth();
            }

            activeNovelId = novelId;
            activeEpisodeId = epId;
            currentScenes = episode.scenes;
            currentSceneIndex = Math.min(Math.max(0, Number(resumeIndex) || 0), currentScenes.length - 1);
            document.getElementById('readerEpisodeTitle').innerText = episode.title;
            hideAllViews();
            document.getElementById('readerView').classList.remove('hidden');
            renderCurrentScene();
        }

