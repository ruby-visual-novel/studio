                    <div class="text-right">
                        <span class="text-amber-400 font-bold">+${u.price} เหรียญ</span>
                        <p class="text-emerald-400 text-[11px]">รับรายได้: +${(u.price * 0.80).toFixed(2)} บ.</p>
                    </div>
                </div>
            `).join('');
        }

