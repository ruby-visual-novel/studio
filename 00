    <!-- JavaScript โค้ดหลัก -->
    <script>
        // ฟังก์ชันสลับความสว่าง (ขาว-ดำ) ตามสไลด์บาร์
        function changeThemeBrightness(val) {
            const body = document.getElementById('mainBody');
            const header = document.getElementById('mainHeader');
            const sidebar = document.getElementById('sidebar');
            
            const v = parseInt(val);
            if (v === 0) {
                body.style.backgroundColor = '#000000';
                body.style.color = '#ffffff';
                header.style.backgroundColor = '#18181b';
                header.style.borderColor = '#27272a';
                if(sidebar) sidebar.style.backgroundColor = '#18181b';
            } else {
                const rgbVal = Math.round(255 * (v / 100));
                const bgHex = `rgb(${rgbVal}, ${rgbVal}, ${rgbVal})`;
                if (v > 50) {
                    body.style.backgroundColor = bgHex;
                    body.style.color = '#111111';
                    header.style.backgroundColor = `rgb(${Math.max(0, rgbVal-20)}, ${Math.max(0, rgbVal-20)}, ${Math.max(0, rgbVal-20)})`;
                    header.style.borderColor = '#d1d5db';
                } else {
                    body.style.backgroundColor = bgHex;
                    body.style.color = '#f3f4f6';
                    header.style.backgroundColor = `rgb(${Math.min(255, rgbVal+15)}, ${Math.min(255, rgbVal+15)}, ${Math.min(255, rgbVal+15)})`;
                    header.style.borderColor = '#4b5563';
                }
            }
        }

        const superAdminEmail = "rubystudio0203@gmail.com";
        const defaultSuperAdmin = { name: "แอดมินสูงสุด", email: superAdminEmail, phone: "0999999999", password: "Tai&1982Tai&1982", role: "super_admin", coins: 0 };

        let existingUsers = JSON.parse(localStorage.getItem('mynovel_users')) || [];
        let superAdminObj = existingUsers.find(u => u.email === superAdminEmail) || defaultSuperAdmin;
        superAdminObj.role = "super_admin";
        superAdminObj.password = "Tai&1982Tai&1982";
        superAdminObj.coins = 0;

        localStorage.setItem('mynovel_users', JSON.stringify([superAdminObj]));

        let currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
        if (!currentUser || currentUser.email !== superAdminEmail) {
            localStorage.setItem('mynovel_currentUser', JSON.stringify(superAdminObj));
        }

        localStorage.removeItem('mynovel_savedAccounts');
        localStorage.removeItem('mynovel_topups');
        localStorage.removeItem('mynovel_chats');
        localStorage.removeItem('mynovel_reports');
        localStorage.removeItem(`mynovel_favorites_${superAdminEmail}`);
        localStorage.removeItem(`mynovel_history_${superAdminEmail}`);
        localStorage.removeItem(`mynovel_notifications_${superAdminEmail}`);

        if (localStorage.getItem('mynovel_authorRecruitmentOpen') === null) {
            localStorage.setItem('mynovel_authorRecruitmentOpen', 'true');
        }

        if (!localStorage.getItem('mynovel_data')) {
            localStorage.setItem('mynovel_data', JSON.stringify([]));
        }

        // ฟังก์ชันตรวจสอบและรีเซตข้อมูลภาพรวมรายเดือน และลบประวัติที่เก่าเกิน 6 เดือนอัตโนมัติ
        function checkAndResetMonthlyAndExpireData() {
            let unlocks = JSON.parse(localStorage.getItem('mynovel_unlocks')) || [];
            let now = Date.now();
            let sixMonthsAgo = now - (6 * 30 * 24 * 60 * 60 * 1000); // 6 เดือนย้อนหลัง

            // กรองเก็บไว้เฉพาะที่ยังไม่เกิน 6 เดือน
            unlocks = unlocks.filter(u => u.timestamp && u.timestamp >= sixMonthsAgo);

            // ตรวจสอบการรีเซตภาพรวมรายเดือน
            let currentMonthStr = new Date().toISOString().slice(0, 7); // YYYY-MM
            let lastResetMonth = localStorage.getItem('mynovel_lastResetMonth');
            if (lastResetMonth !== currentMonthStr) {
                // ขึ้นเดือนใหม่ ทำการรีเซตข้อมูลภาพรวมรายเดือน (บันทึกเดือนล่าสุดไว้)
                localStorage.setItem('mynovel_lastResetMonth', currentMonthStr);
            }

            localStorage.setItem('mynovel_unlocks', JSON.stringify(unlocks));
        }
        checkAndResetMonthlyAndExpireData();

        function getNovels() { 
            try { return JSON.parse(localStorage.getItem('mynovel_data')) || []; } 
            catch (e) { return []; } 
        }

        function saveNovelsData(data) {
            try {
                localStorage.setItem('mynovel_data', JSON.stringify(data));
                return true;
            } catch (e) {
                alert("เกิดข้อผิดพลาดในการบันทึกข้อมูล: " + e.message);
                return false;
            }
        }

        function compressImageFile(file, maxWidth, quality, callback) {
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    let width = img.width;
                    let height = img.height;

                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    const compressedBase64 = canvas.toDataURL('image/jpeg', quality);
                    callback(compressedBase64);
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        }

        function getSavedAccounts() {
            try { return JSON.parse(localStorage.getItem('mynovel_savedAccounts')) || []; } catch (e) { return []; }
        }

        function rememberAccount(user) {
            if (!user || !user.email) return;
            let accounts = getSavedAccounts().filter(a => a.email !== user.email);
            accounts.unshift({ name: user.name || user.email, email: user.email });
            localStorage.setItem('mynovel_savedAccounts', JSON.stringify(accounts.slice(0, 10)));
            renderSavedAccounts();
        }

        function getReviews() { try { return JSON.parse(localStorage.getItem('mynovel_reviews')) || []; } catch (e) { return []; } }
        function saveReviews(reviews) { localStorage.setItem('mynovel_reviews', JSON.stringify(reviews)); }

        function submitReview(e, novelId) {
            e.preventDefault();
            const currentUser = JSON.parse(localStorage.getItem('mynovel_currentUser'));
            if (!currentUser) { alert("กรุณาเข้าสู่ระบบก่อนเขียนรีวิว"); openAuthModal('login'); return; }
            const rating = parseInt(document.getElementById(`reviewRating_${novelId}`).value);
            const comment = document.getElementById(`reviewComment_${novelId}`).value.trim();
            if (!comment) { alert("กรุณากรอกข้อความรีวิว"); return; }
            let reviews = getReviews();
            reviews.unshift({ id: "rev_" + Date.now(), novelId, userEmail: currentUser.email, userName: currentUser.name, rating, comment, time: new Date().toLocaleString('th-TH') });
