        function handleForgotPassword(e) {
            e.preventDefault();
            const input = document.getElementById('recoveryInput').value.trim().toLowerCase();
            let users = JSON.parse(localStorage.getItem('mynovel_users')) || [];
            const foundUser = users.find(u => u.email === input || u.phone === input);
            if (!foundUser) { alert("ไม่พบข้อมูลในระบบ"); return; }
            const otpCode = Math.floor(100000 + Math.random() * 900000);
            foundUser.resetOtp = otpCode;
            localStorage.setItem('mynovel_users', JSON.stringify(users));

            emailjs.send('service_kq4dfrh', 'template_ig4gwka', { to_email: foundUser.email, to_name: foundUser.name, otp_code: otpCode })
                .then(() => {
                    let userOtp = prompt("กรอกรหัส OTP 6 หลัก:");
                    if (userOtp == otpCode) {
                        let newPass = prompt("รหัสผ่านใหม่ (อย่างน้อย 6 ตัวอักษร):");
                        if (newPass && newPass.length >= 6) {
                            foundUser.password = newPass;
                            delete foundUser.resetOtp;
                            localStorage.setItem('mynovel_users', JSON.stringify(users));
                            alert("เปลี่ยนรหัสผ่านสำเร็จ!");
                            switchAuthTab('login');
                        } else { alert("รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร"); }
                    } else { alert("รหัส OTP ไม่ถูกต้อง"); }
                }).catch(() => alert("เกิดข้อผิดพลาดในการส่งอีเมล"));
        }

